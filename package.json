{
  "name": "pypad-studio",
  "version": "1.0.0",
  "description": "PyPad Studio - Native iPad & Web Python IDE",
  "main": "index.html",
  "scripts": {
    "start": "python -m http.server 8080",
    "build": "node -e \"const fs=require('fs'); if(!fs.existsSync('www')) fs.mkdirSync('www'); ['index.html','style.css','app.js','manifest.json','sw.js','pypad.mobileconfig'].forEach(f=>fs.copyFileSync(f,'www/'+f));\""
  },
  "dependencies": {
    "@capacitor/core": "^6.0.0",
    "@capacitor/ios": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0"
  }
}
